{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanicek/local-rides/schemas/road.schema.json",
  "title": "Local Rides road or track segment",
  "type": "object",
  "required": ["schema_version", "id", "kind", "name", "geometry", "categories", "status", "scores", "access", "sources", "visits"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "kind": {"const": "road"},
    "name": {"type": "string", "minLength": 1},
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "LineString"},
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": -180, "maximum": 180},
              {"type": "number", "minimum": -90, "maximum": 90}
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "categories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"enum": ["candidate", "shortlist", "visited", "rejected", "needs_research"]},
    "scores": {
      "type": "object",
      "required": ["destination", "road"],
      "properties": {
        "destination": {"type": "integer", "minimum": 1, "maximum": 5},
        "road": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "required": ["motorcycle", "legal_confidence", "surface"],
      "properties": {
        "motorcycle": {"enum": ["yes", "no", "likely", "unknown"]},
        "legal_confidence": {"enum": ["confirmed", "inferred", "unknown"]},
        "surface": {"enum": ["paved", "unpaved", "gravel", "dirt", "mixed", "unknown"]}
      }
    },
    "sources": {"type": "array"},
    "claims": {"type": "array"},
    "notes": {"type": "string"},
    "visits": {"type": "array"},
    "rejection": {"type": "object"},
    "direction": {"enum": ["either", "forward", "reverse", "unknown"]},
    "difficulty": {"enum": ["easy", "moderate", "difficult", "unknown"]},
    "season": {"type": "string"},
    "length_km": {"type": "number", "minimum": 0}
  }
}
